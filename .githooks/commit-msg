#!/bin/sh
set -eu

subject=''
IFS= read -r subject < "$1" || :

if [ "$subject" = 'initial commit' ] && ! git rev-parse --verify HEAD >/dev/null 2>&1; then
	exit 0
fi

if printf '%s\n' "$subject" | LC_ALL=C grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([[:alnum:]][[:alnum:]_./-]*\))?!?: [^[:space:]].*$'; then
	exit 0
fi

printf '%s\n' \
	'Invalid commit message. Expected: <type>(optional scope)!: <description>' \
	'Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert' \
	'Example: feat(cli): add repository search' >&2
exit 1
